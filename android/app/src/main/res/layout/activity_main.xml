<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg">

    <!-- Layer 1: Live Multi-Tab Web Viewport -->
    <FrameLayout
        android:id="@+id/viewport_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/web_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </FrameLayout>

    <!-- Layer 2: Status Bar Background Strip (visible only on live webpages) -->
    <View
        android:id="@+id/status_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/obsidian_bg"
        android:visibility="gone" />

    <!-- Layer 3: Full-Bleed Edge-to-Edge Butterfly UI / Transparent Modal Sheets / Omnibox -->
    <WebView
        android:id="@+id/ui_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:overScrollMode="never" />

    <!-- Layer 4: Top Chrome Slot (Top-Bar Chrome Mode + Find-in-Page) -->
    <LinearLayout
        android:id="@+id/top_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Slot where url_pill_box moves when Address Bar Position == Top -->
        <FrameLayout
            android:id="@+id/top_url_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- Find-in-Page Bar -->
        <LinearLayout
            android:id="@+id/find_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#F5120F22"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/find_input"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Find on page..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/ink_primary"
                android:textColorHint="@color/ink_muted"
                android:textSize="14.5sp" />

            <ImageView
                android:id="@+id/btn_find_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous match"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_up"
                android:tint="@color/ink_primary" />

            <ImageView
                android:id="@+id/btn_find_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next match"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/ink_primary" />

            <ImageView
                android:id="@+id/btn_find_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close find bar"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@color/amethyst_bright" />
        </LinearLayout>

        <!-- Thin Progress Line (Top Mode) -->
        <ProgressBar
            android:id="@+id/load_progress_top"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#00000000"
            android:progressTint="@color/amethyst"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Layer 5: Safari-Style Scroll-Collapsed Floating Domain Capsule -->
    <LinearLayout
        android:id="@+id/collapsed_pill"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_collapsed_pill"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/collapsed_ico"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Secure"
            android:src="@drawable/ic_lock"
            android:tint="@color/ink_muted" />

        <TextView
            android:id="@+id/collapsed_domain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="220dp"
            android:textColor="@color/ink_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Layer 6: Safari iOS x Samsung Internet Floating Bottom Chrome Dock -->
    <LinearLayout
        android:id="@+id/bottom_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="14dp"
        android:orientation="vertical">

        <!-- Thin Amethyst Page Load Progress Line (Bottom Mode) -->
        <ProgressBar
            android:id="@+id/load_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#00000000"
            android:progressTint="@color/amethyst"
            android:visibility="gone" />

        <!-- Floating Address / Omnibox Slot (Default Bottom Position) -->
        <FrameLayout
            android:id="@+id/bottom_url_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/url_pill_box"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_glass_pill"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <!-- Left: Shield / HTTPS Lock / Private / Search indicator -->
                <LinearLayout
                    android:id="@+id/btn_shield_wrap"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/btn_shield_ico"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="Site Security &amp; Shield"
                        android:src="@drawable/ic_search"
                        android:tint="@color/ink_muted" />

                    <TextView
                        android:id="@+id/btn_shield_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/amethyst_bright"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Center: Omnibox Input (centered when idle like Safari, left-aligned when typing) -->
                <EditText
                    android:id="@+id/url_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:hint="Search or enter website"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/ink_primary"
                    android:textColorHint="@color/ink_muted"
                    android:textSize="14.5sp" />

                <!-- Right: Clear button (visible only while typing) -->
                <ImageView
                    android:id="@+id/btn_url_clear"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear text"
                    android:padding="7dp"
                    android:src="@drawable/ic_clear"
                    android:tint="@color/ink_muted"
                    android:visibility="gone" />

                <!-- Right: Reload / Stop (visible on webpages) -->
                <ImageView
                    android:id="@+id/btn_reload"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Reload"
                    android:padding="7.5dp"
                    android:src="@drawable/ic_reload"
                    android:tint="@color/ink_muted"
                    android:visibility="gone" />

                <!-- Right: 1-Tap Beam to PC (visible on webpages) -->
                <ImageView
                    android:id="@+id/btn_beam_pc"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Send Tab to PC"
                    android:padding="7dp"
                    android:src="@drawable/ic_beam_pc"
                    android:tint="@color/amethyst_bright"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Balanced 5-Icon Thumb Navigation Dock (Safari iOS x Arc x Samsung Internet) -->
        <LinearLayout
            android:id="@+id/nav_dock_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <!-- 1. Back -->
            <ImageView
                android:id="@+id/nav_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                android:tint="@color/ink_primary" />

            <!-- 2. Forward -->
            <ImageView
                android:id="@+id/nav_forward"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Forward"
                android:padding="13dp"
                android:src="@drawable/ic_forward"
                android:tint="@color/ink_primary" />

            <!-- 3. Center Signature Pill: dejavu Link / PC Sync -->
            <FrameLayout
                android:id="@+id/nav_sync_wrap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/nav_sync_pill"
                    android:layout_width="46dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_center_action">

                    <ImageView
                        android:id="@+id/nav_sync"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="dejavu Link"
                        android:src="@drawable/ic_sync"
                        android:tint="@color/amethyst_bright" />

                    <View
                        android:id="@+id/nav_sync_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_sync_dot"
                        android:visibility="gone" />
                </FrameLayout>
            </FrameLayout>

            <!-- 4. Tab Switcher Badge -->
            <FrameLayout
                android:id="@+id/nav_tabs_wrap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/nav_tabs_badge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/ink_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 5. More / Bottom Sheet Menu (•••) -->
            <ImageView
                android:id="@+id/nav_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:padding="13dp"
                android:src="@drawable/ic_more_horiz"
                android:tint="@color/ink_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 7: Floating Dynamic-Island Style Incoming Drop Banner from Windows PC -->
    <LinearLayout
        android:id="@+id/incoming_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_toast_banner"
        android:elevation="18dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/incoming_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="From Windows PC"
            android:textColor="@color/ink_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incoming_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink_muted"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_incoming_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Dismiss"
                android:textColor="@color/ink_muted"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btn_incoming_copy"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Copy"
                android:textColor="@color/ink_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_incoming_open"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_center_action"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Open Tab"
                android:textColor="@color/amethyst_bright"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 7b: Floating Liquid-Glass In-App Auto-Update Banner -->
    <LinearLayout
        android:id="@+id/update_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_toast_banner"
        android:elevation="19dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/update_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Update Available"
            android:textColor="@color/ink_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/update_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="A new version of dejavu Mobile is ready to install"
            android:textColor="@color/ink_muted"
            android:textSize="12.5sp" />

        <ProgressBar
            android:id="@+id/update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="9dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#22FFFFFF"
            android:progressTint="@color/amethyst"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_update_later"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Later"
                android:textColor="@color/ink_muted"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btn_update_now"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_center_action"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Update Now"
                android:textColor="@color/amethyst_bright"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 8: HTML5 Fullscreen Video Container -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />

</FrameLayout>
