<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg">

    <LinearLayout
        android:id="@+id/main_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Thin Amethyst Page Load Progress -->
        <ProgressBar
            android:id="@+id/load_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/amethyst"
            android:progressBackgroundTint="#18FFFFFF"
            android:visibility="gone" />

        <!-- Find-in-Page Floating Bar -->
        <LinearLayout
            android:id="@+id/find_bar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#F5120F22"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/find_input"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Find on page..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/ink_primary"
                android:textColorHint="@color/ink_muted"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btn_find_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous match"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_up"
                android:tint="@color/ink_primary" />

            <ImageView
                android:id="@+id/btn_find_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next match"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/ink_primary" />

            <ImageView
                android:id="@+id/btn_find_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close find bar"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@color/amethyst_bright" />
        </LinearLayout>

        <!-- Main Viewport: Live Multi-Tab WebView + Full-Screen Butterfly Mobile UI -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/web_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <WebView
                android:id="@+id/ui_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/obsidian_bg" />

            <!-- Floating Incoming Drop Banner from Windows PC -->
            <LinearLayout
                android:id="@+id/incoming_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="12dp"
                android:background="@drawable/bg_toast_banner"
                android:elevation="12dp"
                android:orientation="vertical"
                android:padding="13dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/incoming_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="From Windows PC"
                    android:textColor="@color/ink_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/incoming_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_incoming_dismiss"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Dismiss"
                        android:textColor="@color/ink_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_incoming_copy"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_glass_pill"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Copy"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_incoming_open"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tab_badge"
                        android:gravity="center"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="Open Tab"
                        android:textColor="@color/amethyst_bright"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Thumb-Friendly Samsung Internet x Safari Bottom Liquid Glass Chrome -->
        <LinearLayout
            android:id="@+id/bottom_chrome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_bar"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <!-- Row 1: Smart Search & Address Pill + Crisp Shield + Send-to-PC -->
            <LinearLayout
                android:id="@+id/url_pill_box"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:id="@+id/btn_shield_wrap"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp">

                    <ImageView
                        android:id="@+id/btn_shield_ico"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Ad Blocker"
                        android:src="@drawable/ic_shield"
                        android:tint="@color/amethyst_bright" />

                    <TextView
                        android:id="@+id/btn_shield_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textColor="@color/amethyst_bright"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <EditText
                    android:id="@+id/url_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:ellipsize="end"
                    android:hint="Search or enter website name"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/ink_primary"
                    android:textColorHint="@color/ink_muted"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btn_reload"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Reload"
                    android:padding="7dp"
                    android:src="@drawable/ic_reload"
                    android:tint="@color/ink_muted" />

                <ImageView
                    android:id="@+id/btn_beam_pc"
                    android:layout_width="36dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Send Tab to PC"
                    android:padding="7dp"
                    android:src="@drawable/ic_beam_pc"
                    android:tint="@color/amethyst_bright" />
            </LinearLayout>

            <!-- Row 2: Samsung Internet x Safari Crisp Vector Thumb Action Dock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/nav_back"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="11dp"
                    android:src="@drawable/ic_back"
                    android:tint="@color/ink_primary" />

                <ImageView
                    android:id="@+id/nav_forward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Forward"
                    android:padding="11dp"
                    android:src="@drawable/ic_forward"
                    android:tint="@color/ink_primary" />

                <ImageView
                    android:id="@+id/nav_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Home"
                    android:padding="11dp"
                    android:src="@drawable/ic_home"
                    android:tint="@color/ink_primary" />

                <FrameLayout
                    android:id="@+id/nav_tabs_wrap"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <TextView
                        android:id="@+id/nav_tabs_badge"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_tab_badge"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/amethyst_bright"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/nav_sync_wrap"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/nav_sync"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="dejavu Link"
                        android:src="@drawable/ic_sync"
                        android:tint="@color/amethyst_bright" />

                    <View
                        android:id="@+id/nav_sync_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="11dp"
                        android:layout_marginBottom="9dp"
                        android:background="@drawable/bg_sync_dot"
                        android:visibility="gone" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/nav_menu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:padding="11dp"
                    android:src="@drawable/ic_menu"
                    android:tint="@color/ink_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- HTML5 Fullscreen Video Container -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />

</FrameLayout>
